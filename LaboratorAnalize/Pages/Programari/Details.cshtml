@page
@model LaboratorAnalize.Pages.Programari.DetailsModel

@{
    ViewData["Title"] = "Detalii programare";
}

<h1>Detalii programare</h1>

<div>
    <h4>Programare</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">Data</dt>
        <dd class="col-sm-10">@Model.Programare.DataProgramare.ToShortDateString()</dd>

        <dt class="col-sm-2">Ora</dt>
        <dd class="col-sm-10">@Model.Programare.OraProgramare</dd>

        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Model.Programare.Status</dd>

        <dt class="col-sm-2">Pacient</dt>
        <dd class="col-sm-10">@Model.Programare.Pacient?.NumeComplet</dd>

        <dt class="col-sm-2">Pachet</dt>
        <dd class="col-sm-10">@Model.Programare.PachetAnalize?.Denumire</dd>

        <dt class="col-sm-2">Analize selectate</dt>
        <dd class="col-sm-10">
            @if (Model.Programare.ProgramareTipAnalize != null && Model.Programare.ProgramareTipAnalize.Count > 0)
            {
                <ul>
                    @foreach (var a in Model.Programare.ProgramareTipAnalize)
                    {
                        <li>@a.TipAnaliza.Denumire (@a.TipAnaliza.TipProba)</li>
                    }
                </ul>
            }
            else
            {
                <span>-</span>
            }
        </dd>

        <dt class="col-sm-2">Observatii</dt>
        <dd class="col-sm-10">@Model.Programare.Observatii</dd>
    </dl>
</div>

<hr />

<div>
    <h4>Buletin de analize</h4>

    @if (Model.Buletin == null)
    {
        <p class="text-muted">Nu exista buletin emis pentru aceasta programare.</p>

        <a class="btn btn-outline-primary"
           asp-page="/BuletineAnaliza/Create"
           asp-route-programareId="@Model.Programare.ID">
            Genereaza buletin
        </a>
    }
    else
    {
        <p>
            <strong>Buletin #@Model.Buletin.ID</strong>,
            eliberat la <strong>@Model.Buletin.DataEliberare.ToShortDateString()</strong>
        </p>

        @if (!string.IsNullOrEmpty(Model.Buletin.Observatii))
        {
            <p><em>@Model.Buletin.Observatii</em></p>
        }

        <a class="btn btn-outline-secondary"
           asp-page="/BuletineAnaliza/Edit"
           asp-route-id="@Model.Buletin.ID">
            Editeaza buletin
        </a>

        <a class="btn btn-outline-success ms-2"
           asp-page="/RezultateAnalize/Create"
           asp-route-buletinId="@Model.Buletin.ID">
            Adauga rezultat
        </a>


        <hr />

        @if (Model.Rezultate != null && Model.Rezultate.Count > 0)
        {
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Analiza</th>
                        <th>Valoare</th>
                        <th>Unitate</th>
                        <th>Interval</th>
                        <th>In limite</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Rezultate)
                    {
                        <tr>
                            <td>@r.TipAnaliza?.Denumire (@r.TipAnaliza?.TipProba)</td>
                            <td>@r.Valoare</td>
                            <td>@r.Unitate</td>
                            <td>@r.IntervalReferinta</td>
                            <td>@(r.InLimite ? "DA" : "NU")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted">Buletinul exista, dar nu are rezultate introduse inca.</p>
        }
    }
</div>

<div class="mt-3">
    <a asp-page="./Edit" asp-route-id="@Model.Programare.ID">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
