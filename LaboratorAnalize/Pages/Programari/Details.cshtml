@page
@model LaboratorAnalize.Pages.Programari.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Programare</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Programare.DataProgramare)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Programare.DataProgramare)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Programare.Status)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Programare.Status)
        </dd>

        <dt class="col-sm-2">Pacient</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Programare.Pacient.NumeComplet)
        </dd>

        <dt class="col-sm-2">Pachet analize</dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Programare.PachetAnalize.Denumire)
        </dd>

        <dt class="col-sm-2">Tipuri analize</dt>
        <dd class="col-sm-10">
            @if (Model.Programare.ProgramareTipAnalize != null && Model.Programare.ProgramareTipAnalize.Count > 0)
            {
                <ul>
                    @foreach (var a in Model.Programare.ProgramareTipAnalize)
                    {
                        <li>@a.TipAnaliza.Denumire (@a.TipAnaliza.TipProba)</li>
                    }
                </ul>
            }
            else
            {
                <span>-</span>
            }
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Programare.ID">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
