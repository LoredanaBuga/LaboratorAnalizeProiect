@page
@model LaboratorAnalize.Pages.Programari.IndexModel

@{
    ViewData["Title"] = "Programari";
}

<h1>Programari</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>

<form asp-page="./Index" method="get">
    <div class="form-actions no-color">
        <p>
            Cauta dupa pacient / pachet / analiza:
            <input type="text" name="searchString" value="@Model.CurrentFilter" />
            <input type="submit" value="Search" class="btn btn-primary" /> |
            <a asp-page="./Index">Back to full List</a>
        </p>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>
                <a asp-page="./Index"
                   asp-route-sortOrder="@Model.DataSort"
                   asp-route-searchString="@Model.CurrentFilter">
                    Data programare
                </a>
            </th>

            <th>
                <a asp-page="./Index"
                   asp-route-sortOrder="@Model.StatusSort"
                   asp-route-searchString="@Model.CurrentFilter">
                    Status
                </a>
            </th>

            <th>
                <a asp-page="./Index"
                   asp-route-sortOrder="@Model.PacientSort"
                   asp-route-searchString="@Model.CurrentFilter">
                    Pacient
                </a>
            </th>

            <th>Pachet analize</th>
            <th>Analize selectate</th>
            <th>Observatii</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
@foreach (var item in Model.ProgramareD.Programari)
{
    var selectedRow = item.ID == Model.ProgramareID ? "table-success" : "";

    <tr class="@selectedRow">
        <td>@item.DataProgramare.ToShortDateString()</td>
        <td>@item.Status</td>
        <td>@item.Pacient?.NumeComplet</td>
        <td>@item.PachetAnalize?.Denumire</td>
        <td>
            @if (item.ProgramareTipAnalize != null && item.ProgramareTipAnalize.Count > 0)
            {
                foreach (var a in item.ProgramareTipAnalize)
                {
                    @a.TipAnaliza.Denumire <br />
                }
            }
            else
            {
                <span>-</span>
            }
        </td>
        <td>@item.Observatii</td>
        <td>
            <a asp-page="./Index" asp-route-id="@item.ID">Select</a> |
            <a asp-page="./Edit" asp-route-id="@item.ID">Edit</a> |
            <a asp-page="./Details" asp-route-id="@item.ID">Details</a> |
            <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a>
        </td>
    </tr>
}
    </tbody>
</table>

@if (Model.ProgramareD.TipuriAnalize != null && Model.ProgramareD.TipuriAnalize.Any())
{
    <h4>Analize pentru programarea selectata</h4>
    <ul>
        @foreach (var a in Model.ProgramareD.TipuriAnalize)
        {
            <li>@a.Denumire (@a.TipProba)</li>
        }
    </ul>
}
