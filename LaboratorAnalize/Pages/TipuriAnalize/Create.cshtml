@page
@model LaboratorAnalize.Pages.TipuriAnalize.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>TipAnaliza</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="TipAnaliza.Denumire" class="control-label"></label>
                <input asp-for="TipAnaliza.Denumire" class="form-control" />
                <span asp-validation-for="TipAnaliza.Denumire" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TipAnaliza.TipProba" class="control-label"></label>
                <input asp-for="TipAnaliza.TipProba" class="form-control" />
                <span asp-validation-for="TipAnaliza.TipProba" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="TipAnaliza.NecesitaNemancat" /> @Html.DisplayNameFor(model => model.TipAnaliza.NecesitaNemancat)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
