@page
@model LaboratorAnalize.Pages.TipuriAnalize.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TipAnaliza[0].Denumire)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TipAnaliza[0].TipProba)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TipAnaliza[0].NecesitaNemancat)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.TipAnaliza) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Denumire)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TipProba)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NecesitaNemancat)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.ID">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.ID">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
