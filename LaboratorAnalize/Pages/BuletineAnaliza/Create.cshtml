@page
@model LaboratorAnalize.Pages.BuletineAnaliza.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>BuletinAnalize</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="BuletinAnalize.ProgramareID" class="control-label"></label>
                <select asp-for="BuletinAnalize.ProgramareID" class="form-control" asp-items="ViewBag.ProgramareID">
                    <option value="">-- Selecteaza programarea (pacient + data) --</option>
                    <span asp-validation-for="BuletinAnalize.ProgramareID" class="text-danger"></span>

                </select>
            </div>
            <div class="form-group">
                <label asp-for="BuletinAnalize.DataEliberare" class="control-label"></label>
                <input asp-for="BuletinAnalize.DataEliberare" class="form-control" />
                <span asp-validation-for="BuletinAnalize.DataEliberare" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BuletinAnalize.Observatii" class="control-label"></label>
                <input asp-for="BuletinAnalize.Observatii" class="form-control" />
                <span asp-validation-for="BuletinAnalize.Observatii" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
