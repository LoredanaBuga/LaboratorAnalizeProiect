@page
@model LaboratorAnalize.Pages.RezultateAnalize.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Rezultat analiza</h4>
    <hr />
    <dl class="row">

        <dt class="col-sm-3">Buletin (Pacient + Data)</dt>
        <dd class="col-sm-9">
            @Model.RezultatAnaliza.BuletinAnalize.Programare.Pacient.NumeComplet
            -
            @Model.RezultatAnaliza.BuletinAnalize.Programare.DataProgramare.ToShortDateString()
        </dd>

        <dt class="col-sm-3">Analiza</dt>
        <dd class="col-sm-9">
            @Model.RezultatAnaliza.TipAnaliza.Denumire
            (@Model.RezultatAnaliza.TipAnaliza.TipProba)
        </dd>

        <dt class="col-sm-3">Valoare rezultat</dt>
        <dd class="col-sm-9">
            @Model.RezultatAnaliza.Valoare
        </dd>

        <dt class="col-sm-3">Unitate de masura</dt>
        <dd class="col-sm-9">
            @Model.RezultatAnaliza.Unitate
        </dd>

        <dt class="col-sm-3">Interval referinta</dt>
        <dd class="col-sm-9">
            @Model.RezultatAnaliza.IntervalReferinta
        </dd>

        <dt class="col-sm-3">Este in limite?</dt>
        <dd class="col-sm-9">
            @(Model.RezultatAnaliza.InLimite ? "Da" : "Nu")
        </dd>

    </dl>
</div>

<div>
    <a asp-page="./Edit" asp-route-id="@Model.RezultatAnaliza.ID">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
