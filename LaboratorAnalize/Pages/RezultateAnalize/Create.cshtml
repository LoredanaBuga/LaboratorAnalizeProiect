@page
@model LaboratorAnalize.Pages.RezultateAnalize.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Rezultat analiza</h4>
<hr />

<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="RezultatAnaliza.BuletinAnalizeID" class="control-label"></label>
                <select asp-for="RezultatAnaliza.BuletinAnalizeID" class="form-control" asp-items="ViewBag.BuletinAnalizeID">
                    <option value="">-- Selecteaza buletinul --</option>
                </select>
                <span asp-validation-for="RezultatAnaliza.BuletinAnalizeID" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="RezultatAnaliza.TipAnalizaID" class="control-label"></label>
                <select asp-for="RezultatAnaliza.TipAnalizaID" class="form-control" asp-items="ViewBag.TipAnalizaID">
                    <option value="">-- Selecteaza analiza --</option>
                </select>
                <span asp-validation-for="RezultatAnaliza.TipAnalizaID" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="RezultatAnaliza.Valoare" class="control-label"></label>
                <input asp-for="RezultatAnaliza.Valoare" class="form-control" />
                <span asp-validation-for="RezultatAnaliza.Valoare" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="RezultatAnaliza.Unitate" class="control-label"></label>
                <input asp-for="RezultatAnaliza.Unitate" class="form-control" />
                <span asp-validation-for="RezultatAnaliza.Unitate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="RezultatAnaliza.IntervalReferinta" class="control-label"></label>
                <input asp-for="RezultatAnaliza.IntervalReferinta" class="form-control" />
                <span asp-validation-for="RezultatAnaliza.IntervalReferinta" class="text-danger"></span>
            </div>

            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="RezultatAnaliza.InLimite" />
                    @Html.DisplayNameFor(model => model.RezultatAnaliza.InLimite)
                </label>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
